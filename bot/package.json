{
  "name": "teko-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Teko \u2014 AI Bendahara Virtual untuk Arisan on-chain (Telegram + Groq + BNB Chain). Bot Node.js; kontrak Solidity ada di ../contracts (Foundry project di repo root).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.js",
    "start": "node --env-file=.env.local src/index.js",
    "start:prod": "node src/index.js",
    "chain:check": "node --env-file=.env.local src/scripts/check-chain.js",
    "dogfood": "node --env-file=.env.local src/scripts/dogfood.js",
    "verify": "node --env-file=.env.verify.local src/scripts/verify_all.js",
    "test": "node --env-file=.env.test --test \"test/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.940.0",
    "@supabase/supabase-js": "^2.110.8",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^5.2.1",
    "groq-sdk": "^0.9.1",
    "telegraf": "^4.16.3"
  }
}
