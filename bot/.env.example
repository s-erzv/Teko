# ─── Telegram ────────────────────────────────────────────────
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram user ID admin (angka, pisah koma). Cek via @userinfobot
ADMIN_USER_IDS=

# ─── Groq AI ─────────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── BNB Chain (BSC Testnet) ─────────────────────────────────
# Private key Treasury Wallet — JANGAN commit. Hanya wallet dev/burner.
TREASURY_PRIVATE_KEY=
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Alamat kontrak setelah deploy
CONTRACT_ADDRESS=
# Alamat token IDRX (MockIDRX hasil deploy)
IDRX_ADDRESS=
# Alamat TekoReputation hasil deploy (opsional — skor reputasi lintas-grup)
REPUTATION_ADDRESS=

# Buffer gasLimit saat panggil drawRound() via ethers. WAJIB di-set eksplisit:
# _random() baca block.prevrandao sehingga estimasi gas != eksekusi (bisa OutOfGas).
DRAW_GAS_LIMIT=300000

# Parameter default grup arisan (dipakai kalau user tak menyebutkan sendiri).
DEFAULT_CYCLE_LENGTH_SECS=2592000
DEFAULT_PENALTY_PER_DAY_IDR=5000
DEFAULT_EXIT_PENALTY_IDR=20000
DEFAULT_POST_PAYOUT_EXIT_PENALTY_IDR=50000
DEFAULT_RESERVE_BPS=200
DEFAULT_VOTING_WINDOW_SECS=259200

# BNB gas top-up (dalam BNB) yang disponsori ke wallet custodial pemenang
# sebelum sweep IDRX-nya balik ke Treasury / wallet eksternal.
SWEEP_GAS_TOPUP_BNB=0.0006

# ─── AWS KMS (enkripsi private key wallet custodial) ─────────
# Region & Key ID (bukan ARN penuh, cukup key id) dari KMS Customer Managed
# Key yang dibuat khusus buat ini.
AWS_REGION=eu-north-1
KMS_KEY_ID=
# Access Key ID + Secret Access Key dari IAM user khusus (mis. teko-bot) yang
# HANYA diberi izin kms:GenerateDataKey + kms:Decrypt ke key di atas — JANGAN
# pakai root/admin key. AWS SDK baca dua var ini otomatis, tidak lewat config.js.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Xendit (Invoice + Payout) ────────────────────────────────
# Secret Key SANDBOX dari dashboard.xendit.co → Settings → API Keys
XENDIT_SECRET_KEY=
XENDIT_IS_PRODUCTION=false
# Webhook Verification Token dari dashboard.xendit.co → Settings → Webhooks
XENDIT_CALLBACK_TOKEN=
# Port server webhook (Xendit kirim notif ke sini setelah invoice lunas)
WEBHOOK_PORT=3000
# URL publik (mis. ngrok) untuk callback & redirect Xendit. Opsional.
PUBLIC_BASE_URL=

# ─── Revenue / Fee ──────────────────────────────────────────
# Convenience fee off-chain per setoran (Rupiah). Platform fee 1% sudah on-chain.
CONVENIENCE_FEE_IDR=2500

# ─── Supabase (opsional; kalau kosong pakai in-memory store) ─
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
