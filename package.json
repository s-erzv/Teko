{
  "name": "teko",
  "version": "0.1.0",
  "private": true,
  "description": "Teko — AI Bendahara Virtual untuk Arisan on-chain (Telegram + Groq + BNB Chain)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.js",
    "start": "node --env-file=.env.local src/index.js",
    "chain:check": "node --env-file=.env.local src/scripts/check-chain.js",
    "compile": "forge build",
    "test:contract": "forge test -vv",
    "deploy:testnet": "forge script script/Deploy.s.sol:Deploy --rpc-url bscTestnet --broadcast",
    "node:local": "anvil"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^5.2.1",
    "groq-sdk": "^0.9.1",
    "telegraf": "^4.16.3"
  }
}
